# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers). Free M0 tier works.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=geni_us

# Solana devnet RPC (public works; a free Helius devnet URL is more reliable under load)
SOLANA_RPC=https://api.devnet.solana.com

# The market treasury / escrow wallet. Filled in by `npm run wallet`. Fund it at https://faucet.solana.com (devnet).
TREASURY_SECRET_KEY=

# Protects the resolve endpoint (/admin.html)
ADMIN_KEY=change-me

# LMSR liquidity parameter in SOL (house max subsidy per market = b * ln 2)
LMSR_B=0.2
# Devnet SOL the faucet button sends to a new burner wallet
FUND_SOL=0.05
PORT=3000
